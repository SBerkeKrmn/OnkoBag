# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

NODE_ENV=development
PORT=3000

# docker-compose.yml içindeki PostgreSQL servisi
DATABASE_URL="postgresql://onkobag:onkobag_dev_password@localhost:5433/onkobag?schema=public"

# JWT — üretimde uzun, rastgele değerler kullanın
JWT_ACCESS_SECRET=degistir-access-secret
JWT_REFRESH_SECRET=degistir-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Virgülle ayrılmış izinli origin listesi (* = hepsi, yalnızca geliştirme)
CORS_ORIGIN=*
