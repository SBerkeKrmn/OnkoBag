# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

NODE_ENV=development
PORT=3000
# Yüklenen medya dosyalarının URL'leri bu adresle oluşturulur
PUBLIC_URL=http://localhost:3000

# docker-compose.yml içindeki PostgreSQL servisi
DATABASE_URL="postgresql://onkobag:onkobag_dev_password@localhost:5433/onkobag?schema=public"

# JWT — üretimde uzun, rastgele bir değer kullanın
JWT_ACCESS_SECRET=degistir-access-secret
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token (opak, veritabanında hash'lenmiş) geçerlilik süresi
REFRESH_TOKEN_TTL_DAYS=30

# Virgülle ayrılmış izinli origin listesi (* = hepsi, yalnızca geliştirme)
CORS_ORIGIN=*

# E-posta (SMTP). Boş bırakılırsa e-postalar sunucu konsoluna yazdırılır.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OnkoBağ <no-reply@onkobag.local>"

# Google ile giriş — Google Cloud Console > APIs & Services > Credentials altında
# oluşturulan OAuth istemci kimlikleri (Web, iOS, Android), virgülle ayrılmış.
# Boş bırakılırsa Google ile giriş kapalıdır.
GOOGLE_CLIENT_IDS=

# Apple ile giriş — kimlik token'ının "aud" değeri: uygulamanın bundle identifier'ı.
# host.exp.Exponent, Expo Go uygulamasında geliştirme sırasında test için gereklidir.
APPLE_AUDIENCES=com.onkobag.app,host.exp.Exponent

# Medya yükleme
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
