{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "mobile-web-alt",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "mobile", "run", "web", "--", "--port", "8090"],
      "port": 8090
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd mobile && set EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1&& npx expo start --web --port 8091"],
      "port": 8091
    }
  ]
}
