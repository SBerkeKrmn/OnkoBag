{
  "expo": {
    "name": "OnkoBağ",
    "slug": "onkobag",
    "scheme": "onkobag",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onkobag.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.onkobag.app",
      "adaptiveIcon": {
        "backgroundColor": "#EFEBFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "OnkoBağ, gönderilerine, mesajlarına ve profil fotoğrafına eklemek istediğin görselleri seçebilmen için fotoğraflarına erişir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.39:3000/api/v1",
      "googleWebClientId": "",
      "googleIosClientId": ""
    }
  }
}
